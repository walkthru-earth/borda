# Copy to .env (git-ignored). Only the enrichment step needs credentials.

# Hetzner Inference API (OpenAI-compatible) – used by EGMARKET_AI_MODEL=hetzner:<model>
HETZNER_INFERENCE_TOKEN=

# Optional overrides (defaults shown)
# EGMARKET_AI_MODEL=hetzner:Qwen/Qwen3.6-35B-A3B-FP8
# EGMARKET_AI_ENABLED=true
# EGMARKET_AI_BATCH_SIZE=30
# EGMARKET_AI_MAX_ITEMS_PER_RUN=1500
# EGMARKET_AI_REQUESTS_PER_MINUTE=8
# EGMARKET_REQUEST_DELAY_S=0.6
# EGMARKET_MAX_PAGES_PER_STORE=400
# EGMARKET_FUZZY_THRESHOLD=93
# EGMARKET_OUTLIER_FACTOR=8
