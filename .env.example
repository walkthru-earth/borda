# Copy to .env (git-ignored). Only the enrichment step needs credentials.

# Hetzner Inference API (OpenAI-compatible) – used by BORDA_AI_MODEL=hetzner:<model>
HETZNER_INFERENCE_TOKEN=

# Country profile: built-in Egypt, or an absolute path to a custom profile JSON
# BORDA_PROFILE=egypt
# Other profiles use separate data/<id>, diagnostics/<id> and .cache/<id> defaults.
# BORDA_DATA_DIR=/absolute/path/to/catalog-data
# BORDA_DIAGNOSTICS_DIR=/absolute/path/to/diagnostics
# BORDA_CACHE_DIR=/absolute/path/to/http-cache

# Optional overrides (defaults shown)
# BORDA_AI_MODEL=hetzner:Qwen/Qwen3.6-35B-A3B-FP8
# BORDA_AI_ENABLED=true
# BORDA_AI_BATCH_SIZE=20
# BORDA_AI_MAX_ITEMS_PER_RUN=5000
# BORDA_AI_REQUESTS_PER_MINUTE=8     # Hetzner: 10 req + 100k output tokens per 60 s
# BORDA_AI_CONCURRENCY=3             # in-flight batches; generation time is the bottleneck
# BORDA_AI_TIME_BUDGET_MIN=100       # stop launching batches; rest deferred to next run (0 = off)
# BORDA_PROXY_URL=http://user:pass@host:port   # for stores that 403 datacenter IPs
# BORDA_REQUEST_DELAY_S=0.6
# BORDA_MAX_PAGES_PER_STORE=400
# BORDA_FUZZY_THRESHOLD=93
# BORDA_OUTLIER_FACTOR=8
